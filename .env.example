# Copy to .env.local and fill in. NEVER commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Tbilisi
# Short salon addresses {slug}.SITE_DOMAIN (decision 016). Empty = off; on this
# laptop it defaults to localhost:3000. Production: visito.ge
SITE_DOMAIN=

# Supabase (EU region project). Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...     # server only, never NEXT_PUBLIC_

# SMS — fake until Phase 5: prints messages in the dev server window and writes .dev/sms-outbox.jsonl
# (refuses to run in production unless ALLOW_FAKE_SMS=1, e.g. for a staging demo)
SMS_PROVIDER=fake                     # fake | tnet (decision 027) | senderge (decision 018)
SMS_API_KEY=                          # server only — sender.ge API key
# TNET — all values come from TNET at onboarding; server only, never NEXT_PUBLIC_
TNET_BASE_URL=                        # e.g. https://…  (paths like /sms/login are added to it)
TNET_CLIENT_ID=
TNET_SECRET_HASH=
TNET_SENDER=                          # default sender title, exactly as TNET registered it (case matters)
TNET_WEBHOOK_SECRET=                  # 64-hex signing secret for delivery reports (not the login secret)
# Card payments for Visito's plans (decision 031). Flitt's public test merchant: 1549901 / test
PAYMENTS_PROVIDER=none                # none | flitt
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=                     # server only — mark as secret on Netlify
SMS_DEFAULT_SENDER=

# Email: fake (prints to the dev window) or resend (https://resend.com, EU region)
EMAIL_PROVIDER=fake                   # fake | resend
EMAIL_API_KEY=                        # server only (Resend API key)
EMAIL_FROM=                           # e.g. Visito <no-reply@your-domain> — a domain verified in Resend
EMAIL_WEBHOOK_SECRET=

# Background jobs (SMS reminders and queue). Production: a long random value, also set in the
# host scheduler as "Authorization: Bearer <value>". Locally it may stay empty.
CRON_SECRET=

# Payments (Phase 8)
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# Error reports (Sentry, EU region). The DSN is public by design; leave empty to switch off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
